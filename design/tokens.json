{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "TimeSpot design tokens. Source of truth. Generated artifacts: tokens.ts, tokens.css, tailwind.config.js. Values derived by measurement from the supplied mockups — see docs/01-design-audit.md.",
  "_primitive": {
    "$description": "PRIVATE. Components must not reference these. Use the semantic tokens below.",
    "neutral": {
      "0":    { "$type": "color", "$value": "#FFFFFF" },
      "50":   { "$type": "color", "$value": "#F5F5F5" },
      "100":  { "$type": "color", "$value": "#EDEDED" },
      "150":  { "$type": "color", "$value": "#EAEAEA" },
      "200":  { "$type": "color", "$value": "#E8E8E8", "$description": "measured: dominant colour of both boards" },
      "300":  { "$type": "color", "$value": "#DCDCDC" },
      "400":  { "$type": "color", "$value": "#C4C4C4" },
      "500":  { "$type": "color", "$value": "#A8A8A8" },
      "600":  { "$type": "color", "$value": "#7A7A7A", "$description": "measured secondary text — fails AA below 24pt" },
      "700":  { "$type": "color", "$value": "#5C5C5C" },
      "800":  { "$type": "color", "$value": "#3D3D3D" },
      "900":  { "$type": "color", "$value": "#1A1A1A" },
      "950":  { "$type": "color", "$value": "#0B0B0B" },
      "1000": { "$type": "color", "$value": "#000000" }
    },
    "orange": {
      "500": { "$type": "color", "$value": "#D44F24", "$description": "measured: web page bezel" },
      "600": { "$type": "color", "$value": "#BF4620" },
      "700": { "$type": "color", "$value": "#A93B18", "$description": "AA-safe for text" }
    },
    "signal": {
      "day":      { "$type": "color", "$value": "#E8A317" },
      "night":    { "$type": "color", "$value": "#6E7BA8" },
      "meridian": { "$type": "color", "$value": "#D9433B" }
    }
  },

  "color": {
    "light": {
      "bg": {
        "canvas":  { "$type": "color", "$value": "{_primitive.neutral.200}" },
        "card":    { "$type": "color", "$value": "{_primitive.neutral.150}" },
        "inverse": { "$type": "color", "$value": "{_primitive.neutral.1000}" },
        "control": { "$type": "color", "$value": "{_primitive.neutral.0}" },
        "scrim":   { "$type": "color", "$value": "rgba(0,0,0,0.44)" },
        "frame":   { "$type": "color", "$value": "{_primitive.orange.500}" }
      },
      "ink": {
        "primary":             { "$type": "color", "$value": "{_primitive.neutral.1000}" },
        "secondary":           { "$type": "color", "$value": "{_primitive.neutral.700}", "$description": "5.46:1 on canvas — AA" },
        "tertiary":            { "$type": "color", "$value": "{_primitive.neutral.600}", "$description": "3.50:1 — permitted ONLY at >=24pt" },
        "onInverse":           { "$type": "color", "$value": "{_primitive.neutral.0}" },
        "onInverseSecondary":  { "$type": "color", "$value": "{_primitive.neutral.500}" },
        "accent":              { "$type": "color", "$value": "{_primitive.orange.700}" }
      },
      "stroke": {
        "raised": { "$type": "color", "$value": "#F3F3F3" },
        "sunken": { "$type": "color", "$value": "{_primitive.neutral.300}" },
        "focus":  { "$type": "color", "$value": "{_primitive.neutral.1000}" }
      },
      "state": {
        "day":      { "$type": "color", "$value": "{_primitive.signal.day}" },
        "night":    { "$type": "color", "$value": "{_primitive.signal.night}" },
        "meridian": { "$type": "color", "$value": "{_primitive.signal.meridian}" }
      },
      "map": {
        "land":       { "$type": "color", "$value": "#828282" },
        "landActive": { "$type": "color", "$value": "{_primitive.neutral.1000}" },
        "night":      { "$type": "color", "$value": "rgba(0,0,0,0.10)" }
      }
    },
    "dark": {
      "bg": {
        "canvas":  { "$type": "color", "$value": "{_primitive.neutral.950}" },
        "card":    { "$type": "color", "$value": "#161616" },
        "inverse": { "$type": "color", "$value": "#F2F2F2" },
        "control": { "$type": "color", "$value": "#1F1F1F" },
        "scrim":   { "$type": "color", "$value": "rgba(0,0,0,0.64)" },
        "frame":   { "$type": "color", "$value": "{_primitive.orange.600}" }
      },
      "ink": {
        "primary":            { "$type": "color", "$value": "{_primitive.neutral.0}" },
        "secondary":          { "$type": "color", "$value": "{_primitive.neutral.500}" },
        "tertiary":           { "$type": "color", "$value": "{_primitive.neutral.600}" },
        "onInverse":          { "$type": "color", "$value": "{_primitive.neutral.1000}" },
        "onInverseSecondary": { "$type": "color", "$value": "{_primitive.neutral.700}" },
        "accent":             { "$type": "color", "$value": "#E8703F" }
      },
      "stroke": {
        "raised": { "$type": "color", "$value": "#242424" },
        "sunken": { "$type": "color", "$value": "#000000" },
        "focus":  { "$type": "color", "$value": "{_primitive.neutral.0}" }
      },
      "state": {
        "day":      { "$type": "color", "$value": "#F0B54A" },
        "night":    { "$type": "color", "$value": "#8F9CC9" },
        "meridian": { "$type": "color", "$value": "#E85C54" }
      },
      "map": {
        "land":       { "$type": "color", "$value": "#3A3A3A" },
        "landActive": { "$type": "color", "$value": "{_primitive.neutral.0}" },
        "night":      { "$type": "color", "$value": "rgba(0,0,0,0.35)" }
      }
    }
  },

  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Space Grotesk", "-apple-system", "SF Pro Text", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },

  "type": {
    "$description": "mobile = pt @393x852 reference; web = px @1440 reference",
    "display.hero": { "mobile": 144, "web": "clamp(96px, 22vw, 320px)", "weight": 500, "tracking": "-0.035em", "leading": 0.86 },
    "display.xl":   { "mobile": 72,  "web": 120, "weight": 500, "tracking": "-0.03em",  "leading": 0.92 },
    "display.lg":   { "mobile": 56,  "web": 64,  "weight": 500, "tracking": "-0.025em", "leading": 1.02 },
    "display.md":   { "mobile": 36,  "web": 44,  "weight": 500, "tracking": "-0.02em",  "leading": 1.08 },
    "numeral.lg":   { "mobile": 48,  "web": 80,  "weight": 500, "tracking": "-0.02em",  "leading": 1.0, "tabular": true },
    "numeral.md":   { "mobile": 32,  "web": 44,  "weight": 500, "tracking": "-0.015em", "leading": 1.0, "tabular": true },
    "headline":     { "mobile": 24,  "web": 28,  "weight": 500, "tracking": "-0.01em",  "leading": 1.2 },
    "title":        { "mobile": 20,  "web": 24,  "weight": 500, "tracking": "0",        "leading": 1.25 },
    "body":         { "mobile": 16,  "web": 18,  "weight": 400, "tracking": "0",        "leading": 1.45 },
    "label":        { "mobile": 15,  "web": 16,  "weight": 400, "tracking": "0.005em",  "leading": 1.3 },
    "caption":      { "mobile": 13,  "web": 13,  "weight": 400, "tracking": "0.01em",   "leading": 1.3 }
  },

  "space": {
    "0":  { "$type": "dimension", "$value": 0 },
    "1":  { "$type": "dimension", "$value": 4 },
    "2":  { "$type": "dimension", "$value": 8 },
    "3":  { "$type": "dimension", "$value": 12 },
    "4":  { "$type": "dimension", "$value": 16 },
    "5":  { "$type": "dimension", "$value": 20 },
    "6":  { "$type": "dimension", "$value": 24 },
    "7":  { "$type": "dimension", "$value": 28 },
    "8":  { "$type": "dimension", "$value": 32 },
    "9":  { "$type": "dimension", "$value": 40 },
    "10": { "$type": "dimension", "$value": 48 },
    "11": { "$type": "dimension", "$value": 56 },
    "12": { "$type": "dimension", "$value": 64 },
    "14": { "$type": "dimension", "$value": 80 },
    "16": { "$type": "dimension", "$value": 96 },
    "gutter": { "mobile": 28, "web": { "xs": 20, "sm": 28, "md": 32, "lg": 48, "xl": 64 } },
    "rowGap": { "$type": "dimension", "$value": 12 },
    "frame":  { "$type": "dimension", "$value": 26, "$description": "web orange bezel" }
  },

  "size": {
    "row.height":        { "$type": "dimension", "$value": 92,   "$description": "measured 124px @0.75 = 93pt" },
    "cityCard.width":    { "$type": "dimension", "$value": 320 },
    "cityCard.height":   { "$type": "dimension", "$value": 180 },
    "container":         { "$type": "dimension", "$value": 1312, "$description": "1312 + 2*64 = 1440" },
    "avatar":            { "$type": "dimension", "$value": 44 },
    "avatar.overlap":    { "$type": "dimension", "$value": -8 },
    "control.sm":        { "$type": "dimension", "$value": 36 },
    "control.md":        { "$type": "dimension", "$value": 44 },
    "control.lg":        { "$type": "dimension", "$value": 56 },
    "touch.ios":         { "$type": "dimension", "$value": 44 },
    "touch.android":     { "$type": "dimension", "$value": 48 },
    "icon.sm":           { "$type": "dimension", "$value": 16 },
    "icon.md":           { "$type": "dimension", "$value": 20 },
    "icon.lg":           { "$type": "dimension", "$value": 24 },
    "icon.xl":           { "$type": "dimension", "$value": 28 },
    "icon.stroke":       { "$type": "dimension", "$value": 1.75 }
  },

  "radius": {
    "xs":   { "$type": "dimension", "$value": 6 },
    "sm":   { "$type": "dimension", "$value": 10 },
    "md":   { "$type": "dimension", "$value": 16, "$description": "measured: 24px mobile @0.75=18pt, 20px web @0.792=16px" },
    "lg":   { "$type": "dimension", "$value": 24 },
    "xl":   { "$type": "dimension", "$value": 32 },
    "pill": { "$type": "dimension", "$value": 999 }
  },

  "elevation": {
    "none":     { "$value": "none" },
    "hairline": { "$value": "1px solid stroke.raised top/left + 1px solid stroke.sunken bottom/right" },
    "float":    { "light": "0 8px 24px rgba(0,0,0,0.12), 0 2px 6px rgba(0,0,0,0.06)", "dark": "0 8px 24px rgba(0,0,0,0.50)", "android": 8 },
    "overlay":  { "light": "0 24px 64px rgba(0,0,0,0.18)", "dark": "0 24px 64px rgba(0,0,0,0.60)", "android": 24 }
  },

  "duration": {
    "instant":    { "$type": "duration", "$value": "0ms" },
    "fast":       { "$type": "duration", "$value": "140ms" },
    "base":       { "$type": "duration", "$value": "220ms" },
    "slow":       { "$type": "duration", "$value": "320ms" },
    "deliberate": { "$type": "duration", "$value": "480ms" }
  },

  "ease": {
    "standard":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "decelerate": { "$type": "cubicBezier", "$value": [0, 0, 0, 1] },
    "accelerate": { "$type": "cubicBezier", "$value": [0.3, 0, 1, 1] }
  },

  "spring": {
    "numeral": { "damping": 22, "stiffness": 220, "mass": 0.9 },
    "press":   { "damping": 18, "stiffness": 320, "mass": 0.7 }
  },

  "breakpoint": {
    "xs":  { "$type": "dimension", "$value": 0 },
    "sm":  { "$type": "dimension", "$value": 390 },
    "md":  { "$type": "dimension", "$value": 768 },
    "lg":  { "$type": "dimension", "$value": 1024 },
    "xl":  { "$type": "dimension", "$value": 1280 },
    "2xl": { "$type": "dimension", "$value": 1600 }
  },

  "_contractedPairs": {
    "$description": "Asserted by pnpm tokens:contrast. [foreground, background, minRatio, note]",
    "pairs": [
      ["light.ink.primary",   "light.bg.canvas",  4.5,  "17.14"],
      ["light.ink.secondary", "light.bg.canvas",  4.5,  "5.46"],
      ["light.ink.tertiary",  "light.bg.canvas",  3.0,  "3.50 — large text only"],
      ["light.ink.onInverse", "light.bg.inverse", 4.5,  "21.00"],
      ["light.ink.onInverseSecondary", "light.bg.inverse", 4.5, "8.83"],
      ["light.ink.accent",    "light.bg.canvas",  4.5,  "5.15"],
      ["dark.ink.primary",    "dark.bg.canvas",   4.5,  "19.68"],
      ["dark.ink.secondary",  "dark.bg.canvas",   4.5,  "8.28"],
      ["dark.ink.tertiary",   "dark.bg.canvas",   3.0,  "4.27"],
      ["dark.ink.accent",     "dark.bg.canvas",   4.5,  "6.9"]
    ]
  }
}
